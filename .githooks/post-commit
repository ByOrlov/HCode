#!/bin/bash
# Auto-tag every commit as YYYY.MM.DD-<seconds since start of day>
# (commit's local time). On collision (two commits in the same second)
# appends .2, .3, ... to keep tags unique.
#
# Install (one of):
#   git config core.hooksPath .githooks
#   cp .githooks/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit

info=$(git log -1 --pretty=format:%cd --date=format-local:'%Y.%m.%d %H%M%S')
date_part=${info%% *}
hms=${info##* }
secs=$((10#${hms:0:2} * 3600 + 10#${hms:2:2} * 60 + 10#${hms:4:2}))

tag="$date_part-$secs"
base=$tag
n=1
while ! git tag "$tag" >/dev/null 2>&1; do
  tag="$base.$n"
  n=$((n + 1))
done
