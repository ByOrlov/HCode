#!/bin/sh
# mocksudo — simulates sudo's tty-based password prompt for testing.
#
# Real sudo opens /dev/tty, disables echo, reads the password, then runs
# the command. This script does the same so the terminal-exec flow can be
# exercised without root privileges or a real sudo binary.
#
# Install on PATH:  export PATH="$PWD/bin:$PATH"
# Then:             sudo echo "Hello from sudo"

# Prompt on /dev/tty (like real sudo — not stdout/stderr).
printf "[mocksudo] password for %s: " "${USER:-user}" >/dev/tty

# Disable echo on the tty while reading the password.
oldstty=$(stty -g </dev/tty 2>/dev/null)
stty -echo </dev/tty 2>/dev/null

# Read password from /dev/tty.
read -r password </dev/tty

# Restore terminal settings.
stty "$oldstty" </dev/tty 2>/dev/null
printf "\n" >/dev/tty

# Execute the actual command.
exec "$@"
